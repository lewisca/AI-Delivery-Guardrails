{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm run migrate)",
      "Bash(npm install *)",
      "Edit(migrations/**)",
      "Edit(.github/**)",
      "Edit(.claude/**)",
      "Edit(eslint.config.js)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(psql *)",
      "Bash(dropdb *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "defaultMode": "default"
  }
}
